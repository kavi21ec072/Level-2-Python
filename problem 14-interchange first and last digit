def main():
    x = int(input("Enter Number: "))
   # Your Code Here
    last=x%10
    temp=x
    while (temp >=10):
        temp//=10
    first=temp
    
    num=len(str(x))
    
    mid = (x%(10 ** (num-1)))//10
    y=last *(10 **(num-1)) + mid *10 +first
    print(f"Result = {y}")
if __name__ == "__main__":
    main()
